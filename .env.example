# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"
CLIENT_URL="http://localhost:3000"

# MongoDB Connection (MongoDB Atlas URI recommended for production)
# If omitted in local development, PulseDeck boots an isolated local MongoDB instance.
MONGODB_URI=""

# JWT Authentication
# Replace with a cryptographically random 64-character secret in production
JWT_SECRET="replace-with-a-strong-random-jwt-secret-key"
JWT_EXPIRES_IN="7d"

# Official Social Media Platform API Credentials (Optional)
META_APP_ID=""
META_APP_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# Optional Gemini API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"
